{
  "name": "Reboot Root-Cause Analysis",
  "description": "Detects common causes of CPE reboots: WiFi storms, WAN failures, memory crises, kernel panics, and cascading failures. Derived from the built-in reboot_analyzer issue categories.",
  "is_template": true,
  "nodes": [
    {
      "id": "evt_wifi_disconnect_storm",
      "node_type": "EVENT",
      "name": "wifi_disconnect_storm",
      "label": "WiFi Disconnect Storm",
      "domain": "wireless",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "\\bdisassoc",
          "\\bdeauth",
          "disconnected\\s+event",
          "STA\\s+(left|removed|kicked|rejected)",
          "wifi_hal_cb_assoc_dev_evt_handler",
          "invoke\\s+disassoc\\s+callback"
        ],
        "source_domains": ["wireless"]
      },
      "description": "High rate of WiFi client disconnections (disassoc/deauth events)",
      "position_x": 0,
      "position_y": 0
    },
    {
      "id": "evt_btm_steering",
      "node_type": "EVENT",
      "name": "btm_steering",
      "label": "BTM Steering",
      "domain": "wireless",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "\\bBTM\\b",
          "BSS\\s+transition",
          "\\b11v\\b",
          "steer(ing)?\\s+(fail|reject|timeout|abort)",
          "band\\s*steering"
        ],
        "source_domains": ["wireless", "mesh"]
      },
      "description": "802.11v BSS Transition Management steering events",
      "position_x": 200,
      "position_y": 0
    },
    {
      "id": "evt_dfs_channel_switch",
      "node_type": "EVENT",
      "name": "dfs_channel_switch",
      "label": "DFS Channel Switch",
      "domain": "wireless",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "\\bDFS\\b",
          "\\bradar\\b",
          "\\bCAC\\b",
          "channel\\s+(switch|change|dfs)"
        ],
        "source_domains": ["wireless"]
      },
      "description": "DFS radar detection and channel switch / CAC events",
      "position_x": 400,
      "position_y": 0
    },
    {
      "id": "evt_wifi_driver_errors",
      "node_type": "EVENT",
      "name": "wifi_driver_errors",
      "label": "WiFi Driver Errors",
      "domain": "wireless",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "dhd_prot_ioctl",
          "STA\\s+INFO\\s+failed",
          "driver\\s+(crash|recovery|reset|stuck|hang)",
          "radio\\s+(reset|restart|down|fail)",
          "VAP\\s+(down|fail|destroy)"
        ],
        "source_domains": ["wireless", "platform", "common"]
      },
      "description": "WiFi driver crashes, radio resets, and VAP failures",
      "position_x": 0,
      "position_y": 200
    },
    {
      "id": "evt_wan_disconnections",
      "node_type": "EVENT",
      "name": "wan_disconnections",
      "label": "WAN Disconnections",
      "domain": "core_router",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "PPP.*(down|fail|terminated)",
          "DSL\\s*(retrain|sync.?loss|down|drop)",
          "GPON\\s*(deactivat|alarm|down)",
          "WAN\\s*(down|lost|disconnect|fail|flap)",
          "IPv[46]\\s*(unreachable|lost|timeout)",
          "CONNECTION_LOST",
          "PppMgr_Process.*Failed",
          "pppmanager.*error"
        ],
        "source_domains": ["core_router"]
      },
      "description": "WAN/PPP/GPON/DSL link failures and disconnections",
      "position_x": 200,
      "position_y": 200
    },
    {
      "id": "evt_memory_issues",
      "node_type": "EVENT",
      "name": "memory_issues",
      "label": "Memory Crisis",
      "domain": "platform",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "Out\\s+of\\s+memory",
          "\\bOOM\\b",
          "memory\\s*(leak|exhausted|low|pressure)",
          "Mem\\s*critical"
        ],
        "source_domains": ["platform", "common"]
      },
      "description": "Out-of-memory, OOM killer, and memory pressure events",
      "position_x": 400,
      "position_y": 200
    },
    {
      "id": "evt_kernel_crash",
      "node_type": "EVENT",
      "name": "kernel_crash",
      "label": "Kernel Crash",
      "domain": "platform",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "kernel\\s+panic",
          "\\boops\\b",
          "\\bBUG\\b",
          "Segmentation\\s+fault",
          "unexpected\\s+fatal\\s+signal",
          "\\bwatchdog\\b",
          "hung_task",
          "soft\\s+lockup",
          "core\\s+dump"
        ],
        "source_domains": ["platform", "common"]
      },
      "description": "Kernel panics, oops, watchdog timeouts, and lockups",
      "position_x": 600,
      "position_y": 200
    },
    {
      "id": "evt_selfheal_actions",
      "node_type": "EVENT",
      "name": "selfheal_actions",
      "label": "SelfHeal Actions",
      "domain": "platform",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "\\bselfheal\\b",
          "self_heal"
        ],
        "source_domains": ["platform", "common"]
      },
      "description": "SelfHeal daemon triggered restarts or reboots",
      "position_x": 0,
      "position_y": 400
    },
    {
      "id": "evt_ccsp_process_crash",
      "node_type": "EVENT",
      "name": "ccsp_process_crash",
      "label": "CCSP Process Crash",
      "domain": "core_router",
      "detection_config": {
        "method": "keyword",
        "keywords": [
          "CCSP_ERR",
          "CCSP_CRASH",
          "CcspCcMbi_GetParameterValues.*Failure\\s+status",
          "SSP\\s+(restart|crash|exit)",
          "(process|daemon|service)\\s+(crash|exit|killed|died|terminated)"
        ],
        "exclusions": [
          "getDHCPv4ServerPoolParametersFromPSM"
        ],
        "source_domains": ["core_router", "platform", "common"]
      },
      "description": "CCSP component crashes and SSP process restarts",
      "position_x": 200,
      "position_y": 400
    },
    {
      "id": "issue_frequent_reboots",
      "node_type": "ISSUE",
      "name": "frequent_reboots",
      "label": "Frequent Reboots",
      "domain": null,
      "detection_config": null,
      "description": "CPE is experiencing frequent unexpected reboots",
      "position_x": 400,
      "position_y": 500
    },
    {
      "id": "rc_wifi_cascade",
      "node_type": "ROOT_CAUSE",
      "name": "wifi_cascade_failure",
      "label": "WiFi Cascade Failure",
      "domain": "wireless",
      "detection_config": null,
      "description": "WiFi driver errors cascade into disconnect storms, WAN loss, and eventual kernel crash",
      "position_x": 600,
      "position_y": 400
    },
    {
      "id": "rc_memory_cascade",
      "node_type": "ROOT_CAUSE",
      "name": "memory_cascade_failure",
      "label": "Memory Cascade Failure",
      "domain": "platform",
      "detection_config": null,
      "description": "Memory exhaustion leads to kernel crash / OOM-triggered reboot",
      "position_x": 600,
      "position_y": 500
    }
  ],
