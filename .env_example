# LogAI Application Configuration

# Application port (Nginx serves React SPA + proxies /api to Flask)
APP_PORT=40901

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Suppress HuggingFace tokenizers fork warning in Gunicorn workers
TOKENIZERS_PARALLELISM=false

# Qdrant vector database
QDRANT_URL=http://qdrant:6333

# OpenRouter (AI chat) — required for AI chat feature
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: comma-separated list of free model IDs (default: meta-llama/llama-3.3-70b-instruct:free, ...)
# See https://openrouter.ai/collections/free-models
# OPENROUTER_MODELS=qwen/qwen3-coder:free,meta-llama/llama-3.3-70b-instruct:free,nvidia/nemotron-nano-12b-v2-vl:free,deepseek/deepseek-r1-0528:free,google/gemma-2-9b-it:free

# Optional: number of previous messages to include as conversation memory for follow-up queries (default: 20)
# LLM_MAX_HISTORY_MESSAGES=20

# JWT Secret Key (auto-generated if not set; set for persistence across restarts)
# JWT_SECRET_KEY=your-secret-key-here

# JWT token expiration (seconds)
# JWT_ACCESS_EXPIRES=3600
# JWT_REFRESH_EXPIRES=2592000

# ---------------------------------------------------------------------------
# Docker workflow
# ---------------------------------------------------------------------------
# Source code is bind-mounted — no image rebuild for code changes.
# Images only need rebuilding when requirements.txt or system deps change.
#
#   docker-compose --profile build up frontend-build   # build frontend (first time / after changes)
#   docker-compose up                                  # start services (no frontend rebuild)
#   docker-compose restart logai-api                   # pick up backend code changes
