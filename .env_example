# LogAI Application Configuration

# Application port (Nginx serves React SPA + proxies /api to Flask)
APP_PORT=40901

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Suppress HuggingFace tokenizers fork warning in Gunicorn workers
TOKENIZERS_PARALLELISM=false

# Qdrant vector database
QDRANT_URL=http://qdrant:6333

# AI Chat Configuration
# OpenAI (primary) — Get API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# For Azure OpenAI, use format: https://<resource>.openai.azure.com/openai/v1/

# OpenRouter (fallback) — Get free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: comma-separated list of free model IDs (default: meta-llama/llama-3.3-70b-instruct:free, ...)
# See https://openrouter.ai/collections/free-models
# OPENROUTER_MODELS=qwen/qwen3-coder:free,meta-llama/llama-3.3-70b-instruct:free,nvidia/nemotron-nano-12b-v2-vl:free,deepseek/deepseek-r1-0528:free,google/gemma-2-9b-it:free

# Optional: number of previous messages to include as conversation memory for follow-up queries (default: 20)
# LLM_MAX_HISTORY_MESSAGES=20

# JWT Secret Key (auto-generated if not set; set for persistence across restarts)
# JWT_SECRET_KEY=your-secret-key-here

# JWT token expiration (seconds)
# JWT_ACCESS_EXPIRES=3600
# JWT_REFRESH_EXPIRES=2592000

# ---------------------------------------------------------------------------
# Docker workflow
# ---------------------------------------------------------------------------
# Source code is bind-mounted — no image rebuild for code changes.
# Images only need rebuilding when requirements.txt or system deps change.
#
#   docker compose --profile build up frontend-build   # build SPA (needs Compose v2 plugin)
#   ./scripts/build-frontend-docker.sh                 # same SPA build via docker run (no compose subcommand)
#   docker compose up -d                               # start services (no frontend rebuild)
#   docker compose restart logai-api                   # pick up backend code changes
#
# Prefer "docker compose" (v2 plugin), not "docker-compose" (Python v1): v1 can crash with
# KeyError: 'id' on newer Docker engines. If `docker compose` is missing, install
# docker-compose-plugin or use scripts/build-frontend-docker.sh for the SPA only.

# ---------------------------------------------------------------------------
# In-app deployment update (admin only, production servers)
# ---------------------------------------------------------------------------
# Enables Admin → Settings → Application Update (git pull, frontend build, restart).
# Requires: clean git working tree, docker compose on host, API image with git/docker CLI.
# Security: mounts Docker socket into logai-api — enable only on controlled servers.
#
# DEPLOY_UPDATE_ENABLED=1
# DEPLOY_PROJECT_ROOT=/deploy
# Host path to repo root (default in compose: project directory mounted at /deploy)
# DEPLOY_PROJECT_ROOT=.
#
# Optional overrides:
# DEPLOY_HEALTH_CHECK_URL=http://host.docker.internal:40901/api/auth/health
# DEPLOY_LOGAI_DATA_VOLUME=parsemylog-ai_logai_data
# COMPOSE_PROJECT_NAME=parsemylog-ai
